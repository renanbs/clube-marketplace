#!/usr/bin/env bash
# ==============================================================================
# clube-config — Unified AI Suite CLI for Clube Marketplace
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Source shared libraries
if [ -f "$REPO_ROOT/base/shared/lib-harness.sh" ]; then
    # shellcheck source=/dev/null
    source "$REPO_ROOT/base/shared/lib-harness.sh"
fi
if [ -f "$REPO_ROOT/base/shared/lib-runlog.sh" ]; then
    # shellcheck source=/dev/null
    source "$REPO_ROOT/base/shared/lib-runlog.sh"
fi

cmd_help() {
    echo -e "${BOLD}Clube Marketplace AI Suite CLI${NC}"
    echo ""
    echo -e "Usage: ${BOLD}clube-config <command> [options]${NC}"
    echo ""
    echo "Commands:"
    echo "  init [DIR]     Initialize project AI configuration, audit formats, and sync harness pointers"
    echo "  sync [DIR]     Synchronize @AGENTS.md pointers for CLAUDE.md, GEMINI.md, .cursorrules"
    echo "  check          Audit active harness alignment, skills/agents formats, and AGENTS.md integrity"
    echo "  status         Alias for check"
    echo "  install        Install clube-config CLI into ~/.local/bin"
    echo "  help           Display this help message"
}

cmd_check() {
    local active saved
    active="$(detect_active_harness)"
    saved="$(get_saved_harness)"

    echo -e "${BOLD}### 1. Plan${NC}\n"
    echo -e "- **Command:** clube-config check"
    echo -e "- **Action:** Audit AI host harness detection, skills/agents layout, and repository configuration"
    echo -e "- **Reversible:** read-only / not applicable\n"

    echo -e "${BOLD}### 2. Execution${NC}\n"
    echo -e "  ✅ Detected active harness: ${BOLD}$(get_harness_friendly_name "$active")${NC} (${active})"

    if [ -f "AGENTS.md" ]; then
        echo -e "  ✅ Canonical instructions file found: ${BOLD}AGENTS.md${NC}"
    else
        echo -e "  ⚠️ No ${BOLD}AGENTS.md${NC} found in current directory"
    fi

    # Check pointer files
    for f in "CLAUDE.md" "GEMINI.md" ".cursorrules"; do
        if [ -f "$f" ]; then
            local content
            content="$(cat "$f" 2>/dev/null || echo '')"
            if [ "$content" = "@AGENTS.md" ]; then
                echo -e "  ✅ Pointer aligned: ${BOLD}$f${NC} -> @AGENTS.md"
            else
                echo -e "  ⚠️ Custom/legacy content in: ${BOLD}$f${NC} (does not point to @AGENTS.md)"
            fi
        else
            echo -e "  ⏭️ Missing pointer file: ${BOLD}$f${NC}"
        fi
    done

    # Check skills format
    if [ -d "skills" ]; then
        local non_standard_skills=()
        for s in skills/*; do
            if [ -f "$s" ] && [ "${s##*.}" = "md" ]; then
                non_standard_skills+=("$s")
            fi
        done
        if [ ${#non_standard_skills[@]} -gt 0 ]; then
            echo -e "  ⚠️ Non-standard flat skills detected: ${non_standard_skills[*]} (expected: skills/<name>/SKILL.md)"
        else
            echo -e "  ✅ Skills directory structure is compliant"
        fi
    fi

    echo -e "\n${BOLD}### 3. Summary${NC}\n"
    echo -e "| Field | Content |"
    echo -e "| :--- | :--- |"
    echo -e "| Status | check completed |"
    echo -e "| Active Harness | $(get_harness_friendly_name "$active") |"
    echo -e "| AGENTS.md Present | $([ -f "AGENTS.md" ] && echo "yes" || echo "no") |"
    echo -e "| Source of Truth | AGENTS.md |"
}

cmd_sync() {
    local target="${1:-.}"
    echo -e "${BOLD}### 1. Plan${NC}\n"
    echo -e "- **Command:** clube-config sync $target"
    echo -e "- **Action:** Sync @AGENTS.md harness pointers for CLAUDE.md, GEMINI.md, and .cursorrules"
    echo -e "- **Reversible:** Yes, pointer files can be modified or removed\n"

    echo -e "${BOLD}### 2. Execution${NC}\n"
    "$REPO_ROOT/scripts/sync-harness-configs.sh" "$target"

    echo -e "\n${BOLD}### 3. Summary${NC}\n"
    echo -e "| Field | Content |"
    echo -e "| :--- | :--- |"
    echo -e "| Status | sync complete |"
    echo -e "| Source of Truth | AGENTS.md |"
    echo -e "| Target Directory | $target |"
}

cmd_init() {
    local target="${1:-.}"
    echo -e "${BOLD}=== CLUBE PROJECT AI ONBOARDING ===${NC}"
    echo -e "Target directory: ${BOLD}$target${NC}\n"

    # Check for existing instruction files and non-standard formats
    local existing_legacy=()
    for f in "$target/CLAUDE.md" "$target/GEMINI.md" "$target/.cursorrules" "$target/.cursor/rules"*; do
        if [ -e "$f" ]; then
            if [ -f "$f" ]; then
                local content
                content="$(cat "$f" 2>/dev/null || echo '')"
                if [ "$content" != "@AGENTS.md" ]; then
                    existing_legacy+=("$f")
                fi
            elif [ -d "$f" ]; then
                existing_legacy+=("$f")
            fi
        fi
    done

    # Check for flat/non-standard skills
    if [ -d "$target/skills" ]; then
        for s in "$target"/skills/*; do
            if [ -f "$s" ] && [ "${s##*.}" = "md" ]; then
                existing_legacy+=("$s")
            fi
        done
    fi

    if [ ${#existing_legacy[@]} -gt 0 ]; then
        echo -e "${YELLOW}Non-standard formats / custom instruction files detected:${NC}"
        for item in "${existing_legacy[@]}"; do
            echo -e "  • $item"
        done
        echo ""
        echo -e "${BOLD}Options available:${NC}"
        echo -e "  [1] Move to standard format (migrate instructions to AGENTS.md, skills to skills/<name>/SKILL.md)"
        echo -e "  [2] Leave as is (preserve existing files without modifying)"
    fi

    if [ ! -f "$target/AGENTS.md" ]; then
        echo -e "\nCreating base ${BOLD}AGENTS.md${NC} template..."
        cat << 'EOF' > "$target/AGENTS.md"
# Project AI Instructions

## Project Profile
- **Repository:** Project Name
- **Primary Stack:** (e.g., Go, Python, React, Vue, Node)
- **Single Source of Truth:** This AGENTS.md file is the authoritative AI configuration.

## Development Workflow
- Follow standardized conventions for testing, linting, and building.
- Verify changes before completion.
EOF
        echo -e "  ✅ Created $target/AGENTS.md"
    else
        echo -e "  ✅ Existing $target/AGENTS.md preserved."
    fi

    # Sync pointers
    echo -e "\nSyncing harness pointers..."
    "$REPO_ROOT/scripts/sync-harness-configs.sh" "$target"
}

cmd_install() {
    local bin_dir="${HOME}/.local/bin"
    mkdir -p "$bin_dir"
    ln -sf "$SCRIPT_DIR/clube-config" "$bin_dir/clube-config"
    echo -e "${GREEN}✅ Installed clube-config to $bin_dir/clube-config${NC}"
}

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
    init)
        cmd_init "$@"
        ;;
    sync)
        cmd_sync "$@"
        ;;
    check|status)
        cmd_check "$@"
        ;;
    install)
        cmd_install "$@"
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        echo -e "${RED}Unknown command: $COMMAND${NC}"
        cmd_help
        exit 1
        ;;
esac
