#!/usr/bin/env bash
# ==============================================================================
# clube-config — Unified AI Marketplace CLI for Clube
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Source shared libraries
if [ -f "$REPO_ROOT/scripts/lib-harness.sh" ]; then
    # shellcheck source=/dev/null
    source "$REPO_ROOT/scripts/lib-harness.sh"
fi
if [ -f "$REPO_ROOT/scripts/lib-runlog.sh" ]; then
    # shellcheck source=/dev/null
    source "$REPO_ROOT/scripts/lib-runlog.sh"
fi

cmd_help() {
    echo -e "${BOLD}Clube AI Marketplace CLI${NC}"
    echo ""
    echo -e "Usage: ${BOLD}clube-config <command> [options]${NC}"
    echo ""
    echo "Commands:"
    echo "  check          Audit active harness, marketplace catalogs, and plugin integrity"
    echo "  status         Alias for check"
    echo "  sync [DIR]     Synchronize @AGENTS.md pointers for CLAUDE.md, GEMINI.md, .cursorrules"
    echo "  init [DIR]     Initialize project AI configuration and sync harness pointers"
    echo "  install        Install clube-config CLI into ~/.local/bin"
    echo "  help           Display this help message"
}

cmd_check() {
    local active saved
    active="$(detect_active_harness)"
    saved="$(get_saved_harness)"

    echo -e "${BOLD}### 1. Plan${NC}\n"
    echo -e "- **Command:** clube-config check"
    echo -e "- **Action:** Audit AI host harness detection, marketplace catalogs, plugin manifests, and repository configuration"
    echo -e "- **Reversible:** read-only / not applicable\n"

    echo -e "${BOLD}### 2. Execution${NC}\n"
    echo -e "  ✅ Detected active harness: ${BOLD}$(get_harness_friendly_name "$active")${NC} (${active})"

    if [ -f "AGENTS.md" ]; then
        echo -e "  ✅ Canonical instructions file found: ${BOLD}AGENTS.md${NC}"
    else
        echo -e "  ⚠️ No ${BOLD}AGENTS.md${NC} found in current directory"
    fi

    # Check pointer files
    for f in "CLAUDE.md" "GEMINI.md" ".cursorrules"; do
        if [ -f "$f" ]; then
            local content
            content="$(cat "$f" 2>/dev/null || echo '')"
            if [ "$content" = "@AGENTS.md" ]; then
                echo -e "  ✅ Pointer aligned: ${BOLD}$f${NC} -> @AGENTS.md"
            else
                echo -e "  ⚠️ Custom/legacy content in: ${BOLD}$f${NC} (does not point to @AGENTS.md)"
            fi
        else
            echo -e "  ⏭️ Missing pointer file: ${BOLD}$f${NC}"
        fi
    done

    # Check root marketplace manifests
    local market_manifests=(
        ".claude-plugin/marketplace.json"
        ".omp-plugin/marketplace.json"
        ".cursor-plugin/marketplace.json"
        ".agents/plugins/marketplace.json"
    )
    for m in "${market_manifests[@]}"; do
        if [ -f "$REPO_ROOT/$m" ]; then
            echo -e "  ✅ Marketplace catalog present: ${BOLD}$m${NC}"
        else
            echo -e "  ❌ Missing marketplace catalog: ${BOLD}$m${NC}"
        fi
    done

    # Check plugins directory
    if [ -d "$REPO_ROOT/plugins" ]; then
        local plugin_count=0
        for p in "$REPO_ROOT/plugins"/*; do
            if [ -d "$p" ]; then
                plugin_count=$((plugin_count + 1))
                local pname
                pname="$(basename "$p")"
                echo -e "\n  [Plugin: ${BOLD}$pname${NC}]"

                # Check harness manifests inside plugin
                local pmanifests=(
                    ".claude-plugin/plugin.json"
                    ".cursor-plugin/plugin.json"
                    ".codex-plugin/plugin.json"
                    ".omp-plugin/plugin.json"
                )
                for pm in "${pmanifests[@]}"; do
                    if [ -f "$p/$pm" ]; then
                        echo -e "    ✅ Plugin manifest: $pm"
                    else
                        echo -e "    ⏭️ Optional plugin manifest omitted: $pm"
                    fi
                done

                # Check skills directory
                if [ -d "$p/skills" ]; then
                    local valid_skills=0
                    local invalid_skills=0
                    for s in "$p/skills"/*; do
                        if [ -d "$s" ] && [ -f "$s/SKILL.md" ]; then
                            valid_skills=$((valid_skills + 1))
                        elif [ -f "$s" ] && [ "${s##*.}" = "md" ]; then
                            invalid_skills=$((invalid_skills + 1))
                            echo -e "    ⚠️ Non-standard flat skill: $s (expected: skills/<name>/SKILL.md)"
                        fi
                    done
                    echo -e "    ✅ Skills directory: $valid_skills valid modular skills"
                fi

                # Check commands directory
                if [ -d "$p/commands" ]; then
                    local cmd_count
                    cmd_count=$(find "$p/commands" -maxdepth 1 -name "*.md" | wc -l)
                    echo -e "    ✅ Commands directory: $cmd_count slash commands"
                fi
            fi
        done
        if [ "$plugin_count" -eq 0 ]; then
            echo -e "  ⚠️ No plugins found in plugins/ directory"
        fi
    else
        echo -e "  ❌ Missing plugins/ directory"
    fi

    echo -e "\n${BOLD}### 3. Summary${NC}\n"
    echo -e "| Field | Content |"
    echo -e "| :--- | :--- |"
    echo -e "| Status | check completed |"
    echo -e "| Active Harness | $(get_harness_friendly_name "$active") |"
    echo -e "| AGENTS.md Present | $([ -f "AGENTS.md" ] && echo "yes" || echo "no") |"
    echo -e "| Source of Truth | AGENTS.md |"
    echo -e "| Plugins Directory | plugins/ (modular marketplace structure) |"
}

cmd_sync() {
    local target="${1:-.}"
    echo -e "${BOLD}### 1. Plan${NC}\n"
    echo -e "- **Command:** clube-config sync $target"
    echo -e "- **Action:** Sync @AGENTS.md harness pointers for CLAUDE.md, GEMINI.md, and .cursorrules"
    echo -e "- **Reversible:** Yes, pointer files can be modified or removed\n"

    echo -e "${BOLD}### 2. Execution${NC}\n"
    "$REPO_ROOT/scripts/sync-harness-configs.sh" "$target"

    echo -e "\n${BOLD}### 3. Summary${NC}\n"
    echo -e "| Field | Content |"
    echo -e "| :--- | :--- |"
    echo -e "| Status | sync complete |"
    echo -e "| Source of Truth | AGENTS.md |"
    echo -e "| Target Directory | $target |"
}

cmd_init() {
    local target="${1:-.}"
    echo -e "${BOLD}=== CLUBE PROJECT AI ONBOARDING ===${NC}"
    echo -e "Target directory: ${BOLD}$target${NC}\n"

    if [ ! -f "$target/AGENTS.md" ]; then
        echo -e "Creating base ${BOLD}AGENTS.md${NC} template..."
        cat << 'EOF' > "$target/AGENTS.md"
# Project AI Instructions

## Project Profile
- **Repository:** Project Name
- **Primary Stack:** (e.g., Go, Python, React, Vue, Node)
- **Single Source of Truth:** This AGENTS.md file is the authoritative AI configuration.

## Development Workflow
- Follow standardized conventions for testing, linting, and building.
- Verify changes before completion.
EOF
        echo -e "  ✅ Created $target/AGENTS.md"
    else
        echo -e "  ✅ Existing $target/AGENTS.md preserved."
    fi

    # Sync pointers
    echo -e "\nSyncing harness pointers..."
    "$REPO_ROOT/scripts/sync-harness-configs.sh" "$target"
}

cmd_install() {
    local bin_dir="${HOME}/.local/bin"
    mkdir -p "$bin_dir"
    ln -sf "$SCRIPT_DIR/clube-config" "$bin_dir/clube-config"
    echo -e "${GREEN}✅ Installed clube-config to $bin_dir/clube-config${NC}"
}

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
    init)
        cmd_init "$@"
        ;;
    sync)
        cmd_sync "$@"
        ;;
    check|status)
        cmd_check "$@"
        ;;
    install)
        cmd_install "$@"
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        echo -e "${RED}Unknown command: $COMMAND${NC}"
        cmd_help
        exit 1
        ;;
esac
