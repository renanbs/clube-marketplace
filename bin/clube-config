#!/usr/bin/env bash
# ==============================================================================
# clube-config — thin launcher for the Python CLI (clube_cli).
#
# The command logic lives in Python so it can be unit tested; this shim only
# resolves the repository root and hands over.
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if ! command -v python3 >/dev/null 2>&1; then
    echo "clube-config requires python3 on PATH." >&2
    exit 1
fi

# PYTHONPATH so the package resolves regardless of the caller's working directory —
# the CLI is commonly symlinked into ~/.local/bin and run from another project.
export PYTHONPATH="$REPO_ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m clube_cli "$@"
