#!/usr/bin/env bash
# ==============================================================================
# clube-config — Unified AI Marketplace CLI for Clube
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Source shared libraries
if [ -f "$REPO_ROOT/scripts/lib-harness.sh" ]; then
    # shellcheck source=/dev/null
    source "$REPO_ROOT/scripts/lib-harness.sh"
fi
if [ -f "$REPO_ROOT/scripts/lib-runlog.sh" ]; then
    # shellcheck source=/dev/null
    source "$REPO_ROOT/scripts/lib-runlog.sh"
fi

cmd_help() {
    echo -e "${BOLD}Clube AI Marketplace CLI${NC}"
    echo ""
    echo -e "Usage: ${BOLD}clube-config <command> [options]${NC}"
    echo ""
    echo "Commands:"
    echo "  check          Audit active harness, marketplace catalogs, and plugin integrity"
    echo "  status         Alias for check"
    echo "  audit [TYPE]   Run deterministic production audit (all, privacy, performance, seo, tracking)"
    echo "  sync [DIR]     Synchronize @AGENTS.md pointers for CLAUDE.md, GEMINI.md, .cursorrules"
    echo "  init [DIR]     Initialize project AI configuration and sync harness pointers"
    echo "  install        Install clube-config CLI into ~/.local/bin"
    echo "  help           Display this help message"
}

# Counts problems found during `check`. A gate that always exits 0 reports "compliant"
# in every state, which makes the quality claim unfalsifiable — so every failure path
# below must call check_fail.
CHECK_FAILURES=0

check_fail() {
    CHECK_FAILURES=$((CHECK_FAILURES + 1))
}

# Skills that legitimately have no references/ subdirectory. Everything else under
# skills/ is expected to be a decomposed vertical skill. Stated as an exemption list
# rather than an allowlist of vertical skills, so a newly added vertical skill is
# covered by default instead of silently escaping the check.
SKILLS_WITHOUT_REFERENCES=("init" "clube-architecture")

cmd_check() {
    local active saved
    active="$(detect_active_harness)"
    saved="$(get_saved_harness)"
    CHECK_FAILURES=0

    echo -e "${BOLD}### 1. Plan${NC}\n"
    echo -e "- **Command:** clube-config check"
    echo -e "- **Action:** Audit AI host harness detection, marketplace catalogs, plugin manifests, and repository configuration"
    echo -e "- **Reversible:** read-only / not applicable\n"

    echo -e "${BOLD}### 2. Execution${NC}\n"
    echo -e "  ✅ Detected active harness: ${BOLD}$(get_harness_friendly_name "$active")${NC} (${active})"

    if [ -f "AGENTS.md" ]; then
        echo -e "  ✅ Canonical instructions file found: ${BOLD}AGENTS.md${NC}"
    else
        echo -e "  ⚠️ No ${BOLD}AGENTS.md${NC} found in current directory"
    fi

    # Check pointer files
    for f in "CLAUDE.md" "GEMINI.md" ".cursorrules"; do
        if [ -f "$f" ]; then
            local content
            content="$(cat "$f" 2>/dev/null || echo '')"
            if [ "$content" = "@AGENTS.md" ]; then
                echo -e "  ✅ Pointer aligned: ${BOLD}$f${NC} -> @AGENTS.md"
            else
                echo -e "  ⚠️ Custom/legacy content in: ${BOLD}$f${NC} (does not point to @AGENTS.md)"
            fi
        else
            echo -e "  ⏭️ Missing pointer file: ${BOLD}$f${NC}"
        fi
    done

    # Check root marketplace manifests
    local market_manifests=(
        ".claude-plugin/marketplace.json"
        ".omp-plugin/marketplace.json"
        ".cursor-plugin/marketplace.json"
        ".agents/plugins/marketplace.json"
    )
    for m in "${market_manifests[@]}"; do
        if [ -f "$REPO_ROOT/$m" ]; then
            echo -e "  ✅ Marketplace catalog present: ${BOLD}$m${NC}"
        else
            echo -e "  ❌ Missing marketplace catalog: ${BOLD}$m${NC}"
            check_fail
        fi
    done

    # Check plugins directory
    if [ -d "$REPO_ROOT/plugins" ]; then
        local plugin_count=0
        for p in "$REPO_ROOT/plugins"/*; do
            if [ -d "$p" ]; then
                plugin_count=$((plugin_count + 1))
                local pname
                pname="$(basename "$p")"
                echo -e "\n  [Plugin: ${BOLD}$pname${NC}]"

                # Check harness manifests inside plugin
                local pmanifests=(
                    ".claude-plugin/plugin.json"
                    ".cursor-plugin/plugin.json"
                    ".codex-plugin/plugin.json"
                    ".omp-plugin/plugin.json"
                )
                for pm in "${pmanifests[@]}"; do
                    if [ -f "$p/$pm" ]; then
                        echo -e "    ✅ Plugin manifest: $pm"
                    else
                        echo -e "    ⏭️ Optional plugin manifest omitted: $pm"
                    fi
                done

                # Check skills directory
                if [ -d "$p/skills" ]; then
                    local valid_skills=0
                    local invalid_skills=0
                    local total_refs=0
                    for s in "$p/skills"/*; do
                        if [ -d "$s" ] && [ -f "$s/SKILL.md" ]; then
                            valid_skills=$((valid_skills + 1))
                            local sname
                            sname="$(basename "$s")"
                            local exempt=0
                            for e in "${SKILLS_WITHOUT_REFERENCES[@]}"; do
                                [ "$sname" = "$e" ] && exempt=1
                            done

                            if [ -d "$s/references" ]; then
                                local refs
                                refs=$(find "$s/references" -maxdepth 1 -name "*.md" | wc -l)
                                total_refs=$((total_refs + refs))

                                # Progressive disclosure only works while the links resolve.
                                # A broken link makes the deep guide unreachable without any
                                # error: the entrypoint promises knowledge that never loads.
                                local link target
                                while IFS= read -r link; do
                                    [ -n "$link" ] || continue
                                    target="$s/$link"
                                    if [ ! -f "$target" ]; then
                                        echo -e "    ❌ Broken reference link in $sname/SKILL.md: $link"
                                        invalid_skills=$((invalid_skills + 1))
                                        check_fail
                                    fi
                                done < <(grep -oE '\(references/[^)]+\.md\)' "$s/SKILL.md" 2>/dev/null | tr -d '()' | sort -u)

                                # An unreferenced guide is dead weight the entrypoint never routes to.
                                local ref orphan_name
                                while IFS= read -r ref; do
                                    [ -n "$ref" ] || continue
                                    orphan_name="$(basename "$ref")"
                                    if ! grep -q "$orphan_name" "$s/SKILL.md" 2>/dev/null; then
                                        echo -e "    ⚠️ Orphaned reference (not linked from SKILL.md): $sname/references/$orphan_name"
                                        check_fail
                                    fi
                                done < <(find "$s/references" -maxdepth 1 -name "*.md")
                            elif [ "$exempt" -eq 0 ]; then
                                echo -e "    ❌ Missing references/ directory in vertical skill: $sname"
                                invalid_skills=$((invalid_skills + 1))
                                check_fail
                            fi
                        elif [ -f "$s" ] && [ "${s##*.}" = "md" ]; then
                            invalid_skills=$((invalid_skills + 1))
                            check_fail
                            echo -e "    ⚠️ Non-standard flat skill: $s (expected: skills/<name>/SKILL.md)"
                        fi
                    done
                    if [ "$invalid_skills" -gt 0 ]; then
                        echo -e "    ❌ Skills directory: $invalid_skills problem(s) across $valid_skills skills"
                    elif [ "$total_refs" -gt 0 ]; then
                        echo -e "    ✅ Skills directory: $valid_skills valid modular skills ($total_refs topic references)"
                    else
                        echo -e "    ✅ Skills directory: $valid_skills valid modular skills"
                    fi
                fi

                # Check agents directory
                if [ -d "$p/agents" ]; then
                    local valid_agents=0
                    local invalid_agents=0
                    for a in "$p/agents"/*.md; do
                        [ -e "$a" ] || continue
                        local aname frontmatter missing field
                        aname="$(basename "$a")"

                        # Read only the frontmatter block. Grepping the whole file lets a
                        # body line that happens to start with "name:" satisfy the check,
                        # and says nothing about the --- delimiters being present at all.
                        frontmatter="$(awk 'NR==1 && $0!="---" {exit} NR==1 {next} /^---[[:space:]]*$/ {exit} {print}' "$a")"

                        if [ -z "$frontmatter" ]; then
                            invalid_agents=$((invalid_agents + 1))
                            check_fail
                            echo -e "    ❌ Agent has no YAML frontmatter block: $aname"
                            continue
                        fi

                        missing=""
                        for field in name description tools model readonly; do
                            grep -qE "^${field}:" <<< "$frontmatter" || missing="$missing $field"
                        done

                        if [ -z "$missing" ]; then
                            valid_agents=$((valid_agents + 1))
                        else
                            invalid_agents=$((invalid_agents + 1))
                            check_fail
                            echo -e "    ❌ Agent frontmatter missing field(s) in $aname:$missing"
                        fi
                    done
                    if [ "$invalid_agents" -gt 0 ]; then
                        echo -e "    ❌ Agents directory: $invalid_agents invalid, $valid_agents valid specialist agents"
                    else
                        echo -e "    ✅ Agents directory: $valid_agents valid specialist agents"
                    fi
                fi

                # Check commands directory
                if [ -d "$p/commands" ]; then
                    local cmd_count
                    cmd_count=$(find "$p/commands" -maxdepth 1 -name "*.md" | wc -l)
                    echo -e "    ✅ Commands directory: $cmd_count slash commands"
                fi
            fi
        done
        if [ "$plugin_count" -eq 0 ]; then
            echo -e "  ⚠️ No plugins found in plugins/ directory"
            check_fail
        fi
    else
        echo -e "  ❌ Missing plugins/ directory"
        check_fail
    fi

    # SemVer Parity Check across all 9 manifests
    local semver_target="0.2.0"
    local semver_status="v0.2.0 (9/9 aligned)"
    if command -v python3 >/dev/null 2>&1; then
        local semver_output
        semver_output="$(python3 - << 'PYEOF' "$REPO_ROOT" "$semver_target"
import json
import os
import sys

repo_root = sys.argv[1]
target_version = sys.argv[2]

manifests = [
    ("package.json", "root"),
    (".claude-plugin/marketplace.json", "market"),
    (".omp-plugin/marketplace.json", "market"),
    (".cursor-plugin/marketplace.json", "market"),
    (".agents/plugins/marketplace.json", "market"),
    ("plugins/clube/.claude-plugin/plugin.json", "plugin"),
    ("plugins/clube/.cursor-plugin/plugin.json", "plugin"),
    ("plugins/clube/.codex-plugin/plugin.json", "plugin"),
    ("plugins/clube/.omp-plugin/plugin.json", "plugin"),
]

errors = []
total = len(manifests)
matched = 0

for path_rel, kind in manifests:
    full_path = os.path.join(repo_root, path_rel)
    if not os.path.isfile(full_path):
        errors.append(f"Missing file: {path_rel}")
        continue
    try:
        with open(full_path, "r", encoding="utf-8") as f:
            data = json.load(f)
        ver = None
        if kind in ("root", "plugin"):
            ver = data.get("version")
        elif kind == "market":
            plugins = data.get("plugins", [])
            if plugins and isinstance(plugins, list) and isinstance(plugins[0], dict):
                ver = plugins[0].get("version")
            if not ver:
                ver = data.get("version")
        if ver == target_version:
            matched += 1
        else:
            errors.append(f"{path_rel} (found '{ver}', expected '{target_version}')")
    except Exception as e:
        errors.append(f"{path_rel} ({e})")

if matched == total and not errors:
    print(f"OK:{matched}/{total}")
else:
    print(f"ERR:{matched}/{total}:" + "; ".join(errors))
PYEOF
)"
        if [[ "$semver_output" == OK:* ]]; then
            echo -e "\n  ✅ SemVer parity: all manifests aligned at v${semver_target}"
            semver_status="v${semver_target} (all manifests aligned)"
        else
            echo -e "\n  ❌ SemVer parity mismatch: ${semver_output#ERR:}"
            check_fail
            semver_status="mismatch (${semver_output#ERR:})"
        fi
    fi

    local status_label="passed (0 problems)"
    if [ "$CHECK_FAILURES" -gt 0 ]; then
        status_label="FAILED (${CHECK_FAILURES} problem(s))"
    fi

    echo -e "\n${BOLD}### 3. Summary${NC}\n"
    echo -e "| Field | Content |"
    echo -e "| :--- | :--- |"
    echo -e "| Status | ${status_label} |"
    echo -e "| Active Harness | $(get_harness_friendly_name "$active") |"
    echo -e "| SemVer Parity | ${semver_status} |"
    echo -e "| AGENTS.md Present | $([ -f "AGENTS.md" ] && echo "yes" || echo "no") |"
    echo -e "| Source of Truth | AGENTS.md |"
    echo -e "| Plugins Directory | plugins/ (modular marketplace structure) |"

    # Non-zero exit is what makes this usable as a CI gate.
    [ "$CHECK_FAILURES" -eq 0 ]
}

cmd_sync() {
    local target="${1:-.}"
    echo -e "${BOLD}### 1. Plan${NC}\n"
    echo -e "- **Command:** clube-config sync $target"
    echo -e "- **Action:** Sync @AGENTS.md harness pointers for CLAUDE.md, GEMINI.md, and .cursorrules"
    echo -e "- **Reversible:** Yes, pointer files can be modified or removed\n"

    echo -e "${BOLD}### 2. Execution${NC}\n"
    "$REPO_ROOT/scripts/sync-harness-configs.sh" "$target"

    echo -e "\n${BOLD}### 3. Summary${NC}\n"
    echo -e "| Field | Content |"
    echo -e "| :--- | :--- |"
    echo -e "| Status | sync complete |"
    echo -e "| Source of Truth | AGENTS.md |"
    echo -e "| Target Directory | $target |"
}

cmd_init() {
    local target="${1:-.}"
    echo -e "${BOLD}=== CLUBE PROJECT AI ONBOARDING ===${NC}"
    echo -e "Target directory: ${BOLD}$target${NC}\n"

    if [ ! -f "$target/AGENTS.md" ]; then
        echo -e "Creating base ${BOLD}AGENTS.md${NC} template..."
        cat << 'EOF' > "$target/AGENTS.md"
# Project AI Instructions

## Project Profile
- **Repository:** Project Name
- **Primary Stack:** (e.g., Go, Python, React, Vue, Node)
- **Single Source of Truth:** This AGENTS.md file is the authoritative AI configuration.

## Development Workflow
- Follow standardized conventions for testing, linting, and building.
- Verify changes before completion.
EOF
        echo -e "  ✅ Created $target/AGENTS.md"
    else
        echo -e "  ✅ Existing $target/AGENTS.md preserved."
    fi

    # Sync pointers
    echo -e "\nSyncing harness pointers..."
    "$REPO_ROOT/scripts/sync-harness-configs.sh" "$target"
}

cmd_install() {
    local bin_dir="${HOME}/.local/bin"
    mkdir -p "$bin_dir"
    ln -sf "$SCRIPT_DIR/clube-config" "$bin_dir/clube-config"
    echo -e "${GREEN}✅ Installed clube-config to $bin_dir/clube-config${NC}"
}

cmd_audit() {
    local pillar="${1:-all}"
    shift || true
    local target="${1:-.}"

    case "$pillar" in
        all|360)
            python3 "$REPO_ROOT/plugins/clube/scripts/audit-all.py" --target "$target"
            ;;
        privacy)
            python3 "$REPO_ROOT/plugins/clube/scripts/audit-privacy.py" --target "$target"
            ;;
        performance)
            python3 "$REPO_ROOT/plugins/clube/scripts/audit-performance.py" --target "$target"
            ;;
        seo|geo)
            python3 "$REPO_ROOT/plugins/clube/scripts/audit-seo.py" --target "$target"
            ;;
        tracking|attribution)
            python3 "$REPO_ROOT/plugins/clube/scripts/audit-tracking.py" --target "$target"
            ;;
        *)
            echo -e "${RED}Unknown audit pillar: $pillar${NC}"
            echo "Available pillars: all, privacy, performance, seo, tracking"
            exit 1
            ;;
    esac
}

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
    init)
        cmd_init "$@"
        ;;
    audit)
        cmd_audit "$@"
        ;;
    sync)
        cmd_sync "$@"
        ;;
    check|status)
        cmd_check "$@"
        ;;
    install)
        cmd_install "$@"
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        echo -e "${RED}Unknown command: $COMMAND${NC}"
        cmd_help
        exit 1
        ;;
esac
